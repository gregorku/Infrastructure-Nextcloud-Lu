###############################################################################
#
# Infrastructure-Nextcloud-Lu
#
# Template for /docker-data/stacks/infrastructure-nextcloud-lu/.env.
# Values that start with set_ are rejected by check-env.sh.
# Generated passwords are written only into the runtime .env.
# This file contains no real passwords, tokens or keys.
#
# PROXY_PROTOCOL_MODE=local keeps PROXY protocol off so a local test
# can open Traefik without a PROXY header. It must not be used once
# HAProxy sends send-proxy-v2. Mode haproxy requires one or more
# source /32 addresses and never enables proxyProtocol.insecure.
#
# TRAEFIK_TLS_MODE=local uses Traefik's default certificate.
# letsencrypt is HTTP-01 and does not obtain a certificate until
# port 80 reaches this Traefik from the public internet.
#
###############################################################################

TZ=Europe/Prague
COMPOSE_PROJECT_NAME=infrastructure-nextcloud-lu

DATA_DIR=/docker-data/infrastructure-nextcloud-lu
NEXTCLOUD_HTML_HOST_DIR=/docker-data/infrastructure-nextcloud-lu/html
POSTGRESQL_HOST_DIR=set_postgresql_host_dir
NEXTCLOUD_DATA_HOST_DIR=set_nextcloud_data_host_dir
NEXTCLOUD_SOURCE_DATA_DIR=

NEXTCLOUD_DOMAIN=ludek.serveftp.org
NEXTCLOUD_TRUSTED_DOMAINS=ludek.serveftp.org

NEXTCLOUD_IMAGE=docker.io/library/nextcloud
NEXTCLOUD_TAG=35.0.2-fpm
POSTGRES_IMAGE=docker.io/library/postgres:18.6
REDIS_IMAGE=docker.io/library/redis:8.10.2-alpine
NGINX_IMAGE=docker.io/library/nginx:1.30.6-alpine
TRAEFIK_IMAGE=docker.io/library/traefik:v3.6.22
CROWDSEC_IMAGE=docker.io/crowdsecurity/crowdsec:v1.7.8
CROWDSEC_BOUNCER_PLUGIN=v1.7.0
METABASE_IMAGE=docker.io/metabase/metabase:v0.62.4.3
METABASE_POSTGRES_IMAGE=docker.io/library/postgres:17.11

DOCKER_PROXY_SUBNET=set_proxy_subnet
DOCKER_PROXY_GATEWAY=set_proxy_gateway
DOCKER_INTERNAL_SUBNET=set_internal_subnet
DOCKER_INTERNAL_GATEWAY=set_internal_gateway

PG_DB=nextcloud
PG_USER=nextcloud
PG_PASS=set_postgres_password

REDIS_CONFIG_FILE=/docker-data/stacks/infrastructure-nextcloud-lu/runtime/redis.conf
REDIS_PASSWORD=set_redis_password

NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=set_admin_password

TRUSTED_PROXIES=set_trusted_proxies
OVERWRITEPROTOCOL=https
OVERWRITEHOST=ludek.serveftp.org
OVERWRITECLIURL=https://ludek.serveftp.org
FORWARDED_FOR_HEADERS=HTTP_X_FORWARDED_FOR

PROXY_PROTOCOL_MODE=local
PROXY_PROTOCOL_TRUSTED_IPS=
TRAEFIK_TLS_MODE=local
TRAEFIK_ACME_EMAIL=set_acme_email
TRAEFIK_ADMIN_PUBLISH=

ADMIN_IP_ALLOWLIST=set_admin_allowlist

METABASE_HOST=set_metabase_host
METABASE_SITE_URL=set_metabase_site_url
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=set_metabase_db_password

PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G
PHP_OPCACHE_MEMORY_CONSUMPTION=128

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

BACKUP_LOCAL_DIR=/docker-data/backups/infrastructure-nextcloud-lu
BACKUP_EXTERNAL_DIR=
BACKUP_AGE_RECIPIENT=

RESTIC_REPOSITORY=/docker-data/backups/infrastructure-nextcloud-lu/restic
RESTIC_PASSWORD=set_restic_password
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
RESTIC_KEEP_YEARLY=1

UPGRADE_MIN_FREE_MB=5120

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_NAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_DOMAIN=
